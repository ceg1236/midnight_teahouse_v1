# Google Sheets (reservation data)
# Local dev: use key file path
GOOGLE_APPLICATION_CREDENTIALS=./secrets/google-credentials.json
# Vercel: paste full service account JSON (no newlines) - takes precedence over key file
# GOOGLE_CREDENTIALS_JSON={"type":"service_account",...}
SPREADSHEET_ID=your_spreadsheet_id_here
# SPREADSHEET_SHEET_NAME=Sheet1   # Tab name; default Sheet1

# Stripe
# STRIPE_SECRET_KEY=sk_test_... (or sk_live_...)
# STRIPE_WEBHOOK_SECRET=whsec_... (from Stripe CLI or Dashboard webhook)

# App URL (for Stripe success/cancel redirects; Vercel sets VERCEL_URL automatically)
# NEXT_PUBLIC_APP_URL=https://yoursite.com

# Resend (confirmation email)
# RESEND_API_KEY=re_... (from resend.com)
# RESEND_FROM=Midnight Teahouse <hello@mail.midnighttea.house>  # Required for production; use verified domain
# RESEND_REPLY_TO=midnight.teahouse.sf@gmail.com  # Optional; where replies go (default: from address)

# Private event inquiry form on marketing home (optional override; defaults to midnight.teahouse.sf@gmail.com)
# PRIVATE_INQUIRY_TO=midnight.teahouse.sf@gmail.com

# MailerLite — “Stay in the loop” on marketing home (Integrations → API → token; group ID from subscriber groups URL)
# MAILERLITE_API_KEY=...
# MAILERLITE_GROUP_ID=...

# Admin links & door sales (special case tickets)
# ADMIN_LINK_SECRET=  # For signing bypass tokens. Generate: openssl rand -hex 32
# ADMIN_PASSWORD=    # Password for /admin page
